            </div>
            <div class="field">
                <label>{{localizeSystem "sheet.actor.carac.adresse"}}</label>
                <div>{{ fieldOrInput "system.carac.adresse.value" class="pj-sheet-input" }}</div>
            </div>
        </div>
        <div class="flexcols">
            <div class="field">
                <label>{{localizeSystem "sheet.actor.carac.savoir"}}</label>
