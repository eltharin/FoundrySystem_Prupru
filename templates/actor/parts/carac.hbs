                        <label data-action="rollCompetence" data-competence="prouesse">{{localizeSystem "sheet.actor.competences.prouesse"}}</label>
                        <div>
                            <span class="total">{{ system.competences.prouesse.total }}</span>
                        </div>
                        {{#if playWithMalus }}
                            <div>
                                <span class="initial">({{ system.competences.prouesse.value }}</span>
                                <span class="malus">&nbsp;-&nbsp;{{ fieldOrInput "system.competences.prouesse.malus" class="pj-sheet-input" }})</span>
