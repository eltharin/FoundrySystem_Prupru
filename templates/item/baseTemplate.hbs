<div class="system-sheet  {{ SYSTEMID }}-sheet item-sheet">
    <main>
        <div class="top">
            <div >
                <label>{{localize (concat (SYSTEMID) ".sheet.common.nom")}}</label>
                <div>{{ fieldOrInput "name" class="pj-sheet-input" value=document.name }}</div>
            </div>
        </div>
        <div>
            <h2>{{localize (concat (SYSTEMID) ".sheet.common.notes.titre") }}</h2>
            <textarea name="system.notes" rows="5" placeholder="">{{system.notes}}</textarea>
        </div>
    </main>
</div>
